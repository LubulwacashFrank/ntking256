PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/agrotech_connect
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-something-strong

# Flutterwave Payment Gateway (get keys from https://dashboard.flutterwave.com/settings/apis)
FLW_PUBLIC_KEY=your-flutterwave-public-key
FLW_SECRET_KEY=your-flutterwave-secret-key
FLW_ENCRYPTION_KEY=your-flutterwave-encryption-key
